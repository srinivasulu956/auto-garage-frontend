# Two backends now — the garage API and the Auth service are separate.
#
# In development leave these relative. Vite proxies /api/Auth to the Auth service and
# /api to the garage API (see vite.config.js), which also keeps requests same-origin so
# the HTTP-only refresh cookie works.
VITE_API_BASE_URL = /api
VITE_AUTH_BASE_URL = /api/Auth

# In production they are different hosts, so both must be absolute and correct. Pointing
# VITE_AUTH_BASE_URL at the garage API's origin still "works" in dev through the proxy
# and 404s once deployed.
# VITE_API_BASE_URL = https://garage-api.example.com/api
# VITE_AUTH_BASE_URL = https://auth.example.com/api/Auth

# Never put an AI provider key here. Anything VITE_-prefixed is inlined into the
# JavaScript bundle at build time and readable by anyone.
